#!/usr/bin/env node
// A stand-in for pm2 inside the test container. Like the real one, EVERY command first makes
// sure a daemon runs for the user — ~/.pm2/rpc.sock and a live ~/.pm2/pm2.pid — so a probe that
// runs pm2 at all is visible to the test as a change. `start` runs each app of the ecosystem file
// detached with its node_args, cwd and env; `save` writes ~/.pm2/dump.pm2. Test-only.
const fs = require('node:fs')
const path = require('node:path')
const { spawn } = require('node:child_process')
const home = process.env.PM2_HOME || path.join(process.env.HOME, '.pm2')
const stateFile = path.join(home, 'shim-state.json')
const pidFile = path.join(home, 'pm2.pid')
const alive = (pid) => {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}
fs.mkdirSync(path.join(home, 'logs'), { recursive: true })
const daemonPid = fs.existsSync(pidFile) ? Number(fs.readFileSync(pidFile, 'utf8')) : 0
if (!daemonPid || !alive(daemonPid)) {
  const d = spawn(
    process.execPath,
    ['-e', `const fs=require('fs');try{fs.unlinkSync(${JSON.stringify(path.join(home, 'rpc.sock'))})}catch{};require('net').createServer().listen(${JSON.stringify(path.join(home, 'rpc.sock'))});fs.writeFileSync(${JSON.stringify(pidFile)},String(process.pid))`],
    { detached: true, stdio: 'ignore' },
  )
  d.unref()
  for (let i = 0; i < 50 && !fs.existsSync(pidFile); i++) require('node:child_process').execSync('sleep 0.1')
}
const load = () => (fs.existsSync(stateFile) ? JSON.parse(fs.readFileSync(stateFile, 'utf8')) : [])
const [cmd, ...rest] = process.argv.slice(2)
if (cmd === 'start') {
  const { apps } = require(path.resolve(rest[0]))
  const state = load().filter((a) => !apps.some((b) => b.name === a.name))

  for (const app of apps) {
    const log = fs.openSync(path.join(home, 'logs', app.name + '-out.log'), 'a')
    const child = spawn(process.execPath, [...app.node_args.split(' '), app.script], {
      cwd: app.cwd,
      env: { ...process.env, ...app.env },
      detached: true,
      stdio: ['ignore', log, log],
    })
    child.unref()
    state.push({ name: app.name, pid: child.pid, exec_mode: app.exec_mode + '_mode', instances: app.instances, script: app.script })
  }
  fs.writeFileSync(stateFile, JSON.stringify(state))
} else if (cmd === 'describe') {
  const p = load().find((a) => a.name === rest[0])
  process.exit(p && alive(p.pid) ? 0 : 1)
} else if (cmd === 'jlist') {
  const list = load().map((a) => ({
    name: a.name,
    pm2_env: { exec_mode: a.exec_mode, instances: a.instances, status: alive(a.pid) ? 'online' : 'stopped', restart_time: 0, pm_exec_path: a.script },
  }))
  console.log(JSON.stringify(list))
} else if (cmd === 'save') {
  fs.writeFileSync(path.join(home, 'dump.pm2'), JSON.stringify(load().map((a) => ({ name: a.name, pm_exec_path: a.script })), null, 2))
} else {
  console.error('shim pm2: unsupported: ' + process.argv.slice(2).join(' '))
  process.exit(1)
}
