{
  "name": "indies-platform",
  "version": "0.0.0",
  "private": true,
  "description": "The Indies Platform: one Next.js app with Payload embedded and one database, serving the gallery and the shop by hostname (docs/PLAN.md).",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:filesize && pnpm run check:generated && pnpm run tasks:lint && pnpm run tasks:check",
    "format": "prettier --write --no-error-on-unmatched-pattern \"**/*.{js,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,yaml,yml}\" \"!pnpm-lock.yaml\" \"!.claude/**\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"**/*.{js,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,yaml,yml}\" \"!pnpm-lock.yaml\" \"!.claude/**\"",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run --passWithNoTests --exclude \"**/.claude/**\"",
    "build": "pnpm --filter @engine/web run build",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=./lighthouserc.web.json",
    "db:fresh": "node engine/tooling/db/cli.mjs fresh",
    "db:drop": "node engine/tooling/db/cli.mjs drop",
    "db:list": "node engine/tooling/db/cli.mjs list",
    "check:filesize": "node engine/tooling/check-file-size/cli.mjs",
    "check:trackers": "node engine/tooling/no-trackers/cli.mjs",
    "check:generated": "node engine/tooling/config-drift/cli.mjs",
    "tasks:lint": "node engine/tooling/tasks-lint/cli.mjs",
    "tasks:sync": "node scripts/progress.mjs",
    "tasks:tick": "node scripts/progress.mjs --tick",
    "tasks:check": "node scripts/progress.mjs --check",
    "prepare": "node scripts/board/install-hooks.mjs",
    "worktree": "node engine/tooling/worktree/cli.mjs",
    "worktree:env": "node engine/tooling/worktree/cli.mjs env",
    "tasks:start": "node scripts/progress.mjs --start",
    "tasks:report": "node scripts/progress.mjs --report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.5",
    "@eslint/json": "2.1.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
