# Every variable the engine reads (DEPLOYMENT.md §8), grouped, with safe local
# defaults — no real secret is ever a good default, so live values only ever
# come from `.env.local` (gitignored) or, on a server, Infisical → shared/.env
# (DEPLOYMENT.md §8, CONVENTIONS.md §13). Copy this file to `.env.local` and
# fill in what your task needs; `pnpm worktree`/`worktree:env` (1.3) writes
# PORT and DB_SUFFIX into it for you.

# --- This worktree (written by `pnpm worktree`/`worktree:env`, TASKS.md 1.3) --
# PORT       this worktree's dev server port, unique per (phase, lane)
# DB_SUFFIX  this worktree's database suffix — `pnpm db:fresh` names its
#            database <brand>_<DB_SUFFIX>, so two worktrees never share one
#            (engine/tooling/db)
PORT=
DB_SUFFIX=

# --- Brand selection (BRANDS.md §1-2) ---
# BRAND            indies-gallery | old-east-indies | test
# BRAND_ROOT       path to the brand folder shipped in the artifact (config,
#                  copy, assets) — locally, the repo-root brand folder
# TEST_STOREFRONT  CI / the `test` brand only: gallery | emporium — which of
#                  its two configs to load
BRAND=test
BRAND_ROOT=./test
TEST_STOREFRONT=gallery

# --- Payload / the app (DEPLOYMENT.md §8) ---
# DATABASE_URL      postgres://<user>:<password>@<host>:<port>/<database> —
#                   built from the Postgres block below for local dev; a
#                   server's is the brand's own database (ig_db, oei_db)
# PAYLOAD_SECRET    any long random string locally; a real secret on a server
# SITE_URL          the app's own origin, for absolute URLs and CSP
# RUN_MIGRATIONS    1 in the web process only (DEPLOYMENT.md §2) — never set
#                   locally; `pnpm db:fresh` runs migrations itself
DATABASE_URL=
PAYLOAD_SECRET=dev-only-not-a-secret
SITE_URL=http://localhost:3000
RUN_MIGRATIONS=

# --- Local Postgres (docker-compose.dev.yml, engine/tooling/db) ---
# Read by `pnpm db:fresh`/`db:drop`/`db:list` to reach the shared local
# Postgres through `docker compose exec` — not part of DEPLOYMENT.md §8's
# server-side list, but every worktree needs the same defaults to talk to
# one shared container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Media storage (S3-compatible; MinIO locally, DEPLOYMENT.md §2) ---
# S3_ENDPOINT                object storage endpoint (MinIO locally)
# S3_BUCKET                  the brand's public media bucket: ig-media |
#                            oei-media | test-media (2.1.a bootstraps all three)
# S3_ACCESS_KEY_ID / SECRET  MinIO's root user locally; a scoped key on a server
# MEDIA_PUBLIC_URL           the CDN/base URL media is served from
# MASTERS_BUCKET             archive-masters (private; OEI's key writes only
#                            under print-files/ there — DEPLOYMENT.md §2)
# MASTERS_ACCESS_KEY_ID / SECRET
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=test-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_PUBLIC_URL=http://localhost:9000/test-media
MASTERS_BUCKET=archive-masters
MASTERS_ACCESS_KEY_ID=minioadmin
MASTERS_SECRET_ACCESS_KEY=minioadmin

# --- Mail (Mailpit locally, docker-compose.dev.yml) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=dev@example.test
SMTP_FROM_NAME="Indies Platform (dev)"

# --- Payments — per seller, per provider, per environment (PAYMENTS.md §8) ---
# PAYMENT_<SELLER>_<PROVIDER>_*, e.g. PAYMENT_ID_MIDTRANS_SERVER_KEY. Left
# blank here deliberately: which sellers/providers exist is brand config, not
# something this file enumerates. A sandbox key in production, or the
# reverse, fails the boot check (DEPLOYMENT.md §8).
# PAYMENT_ID_MIDTRANS_SERVER_KEY=
# PAYMENT_ID_MIDTRANS_CLIENT_KEY=

# --- Shipping and fulfilment providers ---
# SHIPPING_<PROVIDER>_*, FULFILMENT_<PROVIDER>_* — same per-provider shape as
# payments; left blank for the same reason.
# SHIPPING_<PROVIDER>_API_KEY=
# FULFILMENT_<PROVIDER>_API_KEY=

# --- WhatsApp and the sister-storefront sync ---
# WHATSAPP_*
SISTER_API_KEY=
SISTER_WEBHOOK_SECRET=

# --- Cache invalidation and cron (ARCHITECTURE.md §9, CONVENTIONS.md §12) ---
REVALIDATE_SECRET=dev-only-not-a-secret
CRON_SECRET=dev-only-not-a-secret

# --- Migration workstations only (MIGRATION.md) ---
# LEGACY_DATA_DIR  where the old site's raw extracts live; never committed,
#                  never set on a server
LEGACY_DATA_DIR=
