    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependencies": {
    "next": ">=16.3.3 <17.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  }
