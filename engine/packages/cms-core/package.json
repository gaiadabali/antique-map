    "./import": "./src/import/index.ts",
    "./import/*": "./src/import/*.ts",
    "./registries/entries": "./src/registries/entries.ts",
    "./db/test-templates": "./src/db/test-templates.test-support.ts",
    "./collections/media/pipeline": "./src/collections/media/pipeline.ts",
    "./collections/media/pipeline-hook": "./src/collections/media/pipeline-hook.ts",
    "./config": "./src/config/index.ts",
