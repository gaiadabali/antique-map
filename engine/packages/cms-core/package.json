    "./db/pushed-database": "./src/db/pushed-database.test-support.ts",
    "./db/staff-stack": "./src/db/staff-stack.test-support.ts",
    "./db/media-stack": "./src/db/media-stack.test-support.ts",
    "./globals/site-settings/common": "./src/globals/site-settings/common.ts",
    "./db/migrated-stack": "./src/db/migrated-stack.test-support.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@engine/cache": "workspace:*",
    "@engine/config": "workspace:*",
    "@engine/media": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
