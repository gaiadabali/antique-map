    "./db/probe": "./src/db/probe.ts",
    "./db/schema": "./src/db/schema.ts",
    "./db/test-database": "./src/db/test-database.test-support.ts",
    "./db/test-origin": "./src/db/test-origin.test-support.ts",
    "./collections/media/kinds": "./src/collections/media/kinds.ts",
    "./collections/*": "./src/collections/*/index.ts",
    "./globals/*": "./src/globals/*/index.ts",
    "./access/store-staff": "./src/access/store-staff.ts",
    "./access/vocabulary": "./src/access/vocabulary.ts",
    "./admin/groups": "./src/admin/groups.ts",
    "./admin/page": "./src/admin/page.jsx",
    "./admin/shared": "./src/admin/shared.jsx",
    "./admin/leads-copy": "./src/admin/leads-copy.ts",
    "./admin/image": "./src/admin/image.ts",
    "./admin/language-link": "./src/admin/language-link.jsx",
