    "./admin/nav/copy": "./src/admin/nav/copy.ts",
    "./admin/nav/view": "./src/admin/nav/view.jsx",
    "./admin/home/view": "./src/admin/home/view.jsx",
    "./admin/dashboard/*": "./src/admin/dashboard/*.ts",
