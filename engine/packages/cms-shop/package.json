{
  "name": "@engine/cms-shop",
  "version": "0.0.0",
  "private": true,
  "description": "Old East Indies' CMS (PLAN-V2.md §3, §4.1): the shop's Payload config on its own database (indies_shop) — products, categories, stores, stock levels, orders, order notifications, discounts, partners, payment events, the shop's globals and admin screens, its writes (orders, stock, payments, fulfilment, notifications), its own migrations, payload-types.ts and import map. The shared collections come from @engine/cms-core with the shop's roles (owner, editor, store); no record carries `site`. Today's one CMS (@engine/cms) builds its shop collections from the factories here until phase 26.",
  "type": "module",
  "exports": {
    "./payload.config": "./src/payload.config.ts",
    "./instance": "./src/instance.ts",
    "./collections": "./src/collections/index.ts",
    "./globals": "./src/globals/index.ts",
    "./collections/leads/create-partner": "./src/collections/leads/create-partner.ts",
    "./collections/media/product-defaults": "./src/collections/media/product-defaults.ts",
    "./collections/orders/statuses": "./src/collections/orders/statuses.ts",
    "./globals/site-settings/shop": "./src/globals/site-settings/shop/index.ts",
    "./globals/site-settings/shop/product-page": "./src/globals/site-settings/shop/product-page.ts",
    "./hooks/product-invalidate": "./src/hooks/product-invalidate.ts",
    "./admin/views": "./src/admin/views.ts",
    "./admin/orders": "./src/admin/orders/index.ts",
    "./admin/nav-plan": "./src/admin/nav-plan.ts",
    "./admin/registry": "./src/admin/registry.ts",
    "./admin/preview": "./src/admin/preview/index.ts",
    "./admin/today/view": "./src/admin/today/view.jsx",
    "./admin/today/styles-client": "./src/admin/today/styles-client.jsx",
    "./admin/dashboard/sales": "./src/admin/dashboard/sales.ts",
    "./admin/dashboard/payments": "./src/admin/dashboard/payments.ts",
    "./admin/dashboard/fulfilment": "./src/admin/dashboard/fulfilment.ts",
    "./admin/dashboard/panels-shop": "./src/admin/dashboard/panels-shop.jsx",
    "./import": "./src/import/index.ts",
    "./pricing": "./src/shop/pricing/index.ts",
    "./orders": "./src/shop/orders/index.ts",
    "./payments": "./src/shop/payments/index.ts",
    "./payments/http": "./src/shop/payments/http/index.ts",
    "./fulfilment": "./src/shop/fulfilment/index.ts",
    "./fulfilment/staff-routes": "./src/shop/fulfilment/staff-routes.ts",
    "./notify": "./src/shop/notify/index.ts",
