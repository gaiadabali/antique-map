    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "next": "16.4.6",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.1"
  }
