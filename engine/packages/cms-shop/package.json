    "./collections/payment-events/append-only": "./src/collections/payment-events/append-only.ts",
    "./collections/products/money": "./src/collections/products/money.ts",
    "./collections/products/skus": "./src/collections/products/skus.ts",
    "./collections/articles/feedback-access.test-support": "./src/collections/articles/feedback-access.test-support.ts",
    "./collections/stock-levels/shop.test-support": "./src/collections/stock-levels/shop.test-support.ts",
    "./fulfilment/fulfilment-db.test-support": "./src/shop/fulfilment/fulfilment-db.test-support.ts",
    "./orders/orders-db.test-support": "./src/shop/orders/orders-db.test-support.ts",
    "./site": "./src/site.ts",
    "./seed": "./src/seed/index.ts",
    "./seed/env": "./src/seed/env.ts",
    "./seed/req": "./src/seed/req.ts",
    "./seed/catalogue/db-checks.test-support": "./src/seed/catalogue/db-checks.test-support.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types && prettier --write --log-level warn payload-types.ts",
    "generate:importmap": "payload run src/registries/import-map.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload run src/db/generate-migration.ts",
    "migrate:status": "payload migrate:status",
    "test:db": "vitest run --config vitest.config.ts",
    "seed": "payload run src/seed/cli.ts --"
  },
  "dependencies": {
    "@engine/cache": "workspace:*",
    "@engine/cms-core": "workspace:*",
    "@engine/config": "workspace:*",
    "@engine/media": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
