{
  "name": "@engine/cms",
  "version": "0.0.0",
  "private": true,
  "description": "The one Payload config: one CMS and one database serving both sites (the gallery and the shop). Collections, access helpers, the database adapter (db/), the job/view/plugin registries and the one migration set.",
  "type": "module",
  "exports": {
    "./payload.config": "./src/payload.config.ts",
    "./instance": "./src/instance.ts",
    "./access": "./src/access/index.ts",
    "./ai": "./src/ai/index.ts",
    "./import": "./src/import/index.ts",
    "./seed": "./src/seed/index.ts",
    "./registries": "./src/registries/index.ts",
    "./db/probe": "./src/db/probe.ts",
    "./admin/widgets": "./src/admin/widgets/index.ts",
    "./admin/views": "./src/admin/views.ts",
    "./admin/orders": "./src/admin/orders/index.ts",
    "./shop/pricing": "./src/shop/pricing/index.ts",
    "./shop/orders": "./src/shop/orders/index.ts",
    "./shop/payments": "./src/shop/payments/index.ts",
    "./shop/payments/http": "./src/shop/payments/http/index.ts",
    "./shop/fulfilment": "./src/shop/fulfilment/index.ts",
    "./shop/notify": "./src/shop/notify/index.ts",
    "./jobs/retention": "./src/jobs/retention/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "import": "payload run src/import/cli.ts --",
    "seed": "payload run src/seed/cli.ts --",
    "seed:purge": "payload run src/seed/purge-cli.ts",
    "gallery:sample": "payload run src/seed/gallery/sample.ts",
    "media:derivatives": "payload run src/collections/media/derivatives-cli.ts --",
    "generate:types": "payload generate:types && prettier --write --log-level warn payload-types.ts",
    "generate:importmap": "payload run src/registries/import-map.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload run src/db/generate-migration.ts",
    "migrate:status": "payload migrate:status",
    "schema:check": "payload run src/db/schema-check.ts"
  },
  "dependencies": {
    "@engine/cache": "workspace:*",
    "@engine/config": "workspace:*",
    "@engine/media": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "graphql": "16.11.0",
    "nodemailer": "9.1.1",
    "payload": "3.90.2"
  },
  "peerDependencies": {
    "next": ">=16.3.3 <17.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "next": "16.3.8",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
