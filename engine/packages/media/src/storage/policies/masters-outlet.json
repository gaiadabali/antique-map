{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCapturesAndPrintFiles",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::{{mastersBucket}}"],
      "Condition": { "StringLike": { "s3:prefix": ["masters/*", "print-files/*"] } }
    },
    {
      "Sid": "ReadCapturesAndPrintFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::{{mastersBucket}}/masters/*",
        "arn:aws:s3:::{{mastersBucket}}/print-files/*"
      ]
    },
    {
      "Sid": "WriteOnlyItsOwnPrintFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::{{mastersBucket}}/print-files/{{brand}}/*"]
    }
  ]
}
