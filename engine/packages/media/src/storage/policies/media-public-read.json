{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicDerivativesAndCappedTilesOnly",
      "Effect": "Allow",
      "Principal": { "AWS": ["*"] },
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::{{mediaBucket}}/derivatives/*",
        "arn:aws:s3:::{{mediaBucket}}/iiif/*"
      ]
    }
  ]
}
