{
  "//": "The public-read settings for this brand's old store (TASKS.md 7.1.c, D41). Read-only, GET only, no sign-in, no forms. The engine reader refuses an interval under 2000 ms and a browser-like User-Agent; robots.txt is fetched first and obeyed.",
  "baseUrl": "https://antiquemapsindonesia.com",
  "userAgent": "IndiesPlatformMigrationReader/0.1 (read-only copy of the public catalogue for the site owner's new website; one request every 2 s; honours robots.txt)",
  "minIntervalMs": 2000,
  "maxAttempts": 4,
  "maxConsecutiveFailures": 3,
  "seeds": ["/"],
  "routes": {
    "product": "^/product/(?<id>\\d+)-(?<slug>[^/?#]*)$",
    "image": "^/storage/products/(?<productId>\\d+)-(?<imageId>\\d+)(?<size>[A-Z]?)\\.(?:jpe?g|png|webp|gif)$",
    "listings": {
      "category": "^/category/(?<id>\\d+)-(?<slug>[^/?#]*)$",
      "maker": "^/mapmaker/(?<id>\\d+)-(?<slug>[^/?#]*)$"
    }
  },
  "fetchQuery": {
    "page": "*",
    "s": ["sold"]
  },
  "categoryTree": {
    "variable": "db",
    "pathTemplate": "/category/{id}-{slug}"
  },
  "never": [
    "^/account(?:[/?]|$)",
    "^/(?:login|logout|register)(?:[/?]|$)",
    "^/password(?:[/?]|$)",
    "^/(?:cart|checkout|wishlist|basket)(?:[/?]|$)",
    "^/s(?:[/?]|$)",
    "^/search(?:[/?]|$)",
    "^/api(?:[/?]|$)",
    "^/admin(?:[/?]|$)",
    "/(?:enquire|request|subscribe)(?:[/?]|$)",
    "[?&](?:token|signature|email|_token)="
  ],
  "fetchImages": true,
  "trySitemaps": true,
  "pages": {
    "product": {
      "panel": ".sideinfo",
      "panelRow": ".row",
      "panelLabel": ".bg-dark",
      "panelHeading": ".sideinfo > .bg-dark .txt",
      "longTitle": ".content .box .title",
      "description": ".content .box",
      "soldMarker": "#add-to-cart a[href='#sold-out']"
    },
    "card": {
      "item": ".product-item",
      "title": "h2.title a",
      "maker": ".mapmaker a",
      "categories": ".category a",
      "field": ".clearfix",
      "fieldLabel": ".lbl",
      "price": ".price",
      "soldMarker": "a[href='#sold-out']"
    }
  }
}
