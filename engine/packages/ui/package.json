{
  "name": "@engine/ui",
  "version": "0.0.0",
  "private": true,
  "description": "What both sites draw with (PLAN-V2.md §3): the base tokens, both site palettes, the admin tokens and the fonts; the shared components; the first-party beacon client. No app, no Payload, no database. Ships as TypeScript and CSS source: an app lists it in transpilePackages.",
  "type": "module",
  "exports": {
    ".": "./src/components/index.ts",
    "./beacon": "./src/beacon/beacon.ts",
    "./fonts": "./src/styles/fonts.ts",
    "./format-rupiah": "./src/components/price/format-rupiah.ts",
    "./tokens/*": "./src/styles/tokens/*",
    "./admin/*": "./src/styles/admin/*",
    "./*": "./src/components/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
