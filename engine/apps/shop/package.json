  "scripts": {
    "dev": "node ../../tooling/next-port/cli.mjs dev",
    "build": "next build",
    "start": "node ../../tooling/next-port/cli.mjs start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@engine/cache": "workspace:*",
    "@engine/chat": "workspace:*",
    "@engine/cms-core": "workspace:*",
    "@engine/cms-shop": "workspace:*",
    "@engine/config": "workspace:*",
    "@engine/http": "workspace:*",
    "@engine/i18n": "workspace:*",
    "@engine/media": "workspace:*",
    "@engine/site": "workspace:*",
    "@engine/storefront": "workspace:*",
    "@engine/ui": "workspace:*",
    "@engine/view-models": "workspace:*",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
