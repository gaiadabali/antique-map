# Indies Platform — what never enters git.
# Prettier and ESLint read this file too (eslint.config.mjs imports it), so an
# ignored path is ignored by every gate at once.

# Dependencies and package-manager state
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# Build output and caches
.next/
# Written by `next typegen`/`next build` in each app (PARALLEL-TRACKS.md §2: generated, edited by
# nobody). Untracked but visible, a second `pnpm verify` fails `format:check` on it (TASKS.md 4.4.d).
**/next-env.d.ts
dist/
coverage/
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
.vite/
.vitest/

# The local upload bucket's disk (registries/storage.ts falls back to it when no bucket is set): runtime data.
engine/packages/cms/media/

# Environment files: secrets never go into the repo (CONVENTIONS.md §13).
# The template is the one exception.
.env
.env.*
!.env.example

# Local databases and their dumps, per brand folder (e.g. test/db/)
*/db/

# The old site's raw extracts live in LEGACY_DATA_DIR, never in git. Mapping
# files and URL inventories elsewhere under content/legacy/ ARE committed.
*/content/legacy/raw/**

# Test and audit artefacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
.lighthouseci/

# The progress script's lock (scripts/progress.mjs)
TASKS.md.lock

# Agent worktrees and per-person Claude Code settings. The worktrees are full
# checkouts: left visible, every gate would lint and test other agents' work.
.claude/worktrees/
.claude/settings.local.json

# The impeccable skill's engine binary: its launcher downloads and verifies it.
.claude/skills/impeccable/scripts/bin/

# Editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.log
